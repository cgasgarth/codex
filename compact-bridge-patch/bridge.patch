+package integration
+
+import (
+	"encoding/json"
+	"github.com/gorilla/websocket"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+func TestWebSocketCompactReplayReplacesOldHistory(t *testing.T) {
+	h := newHarness(t)
+	conn, _, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(h.baseURL, "http")+"/v1/responses", http.Header{"Authorization": {"Bearer " + accessKey}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	send := func(payload any) []string {
+		t.Helper()
+		if err := conn.WriteJSON(payload); err != nil {
+			t.Fatal(err)
+		}
+		return readWSEvents(t, conn)
+	}
+	first := send(map[string]any{"type": "response.create", "model": bridgeModel, "input": []any{map[string]any{"type": "message", "role": "user", "content": "OLD_HISTORY_SENTINEL"}}})
+	compact := send(map[string]any{"type": "response.create", "model": bridgeModel, "previous_response_id": completedResponseID(first), "input": []any{map[string]any{"type": "compaction_trigger"}}})
+	var event struct {
+		Item json.RawMessage `json:"item"`
+	}
+	if err := json.Unmarshal([]byte(compact[0]), &event); err != nil {
+		t.Fatal(err)
+	}
+	check := func() {
+		t.Helper()
+		calls := h.upstream.snapshot()
+		body := string(calls[len(calls)-1].Body)
+		if strings.Contains(body, "OLD_HISTORY_SENTINEL") || strings.Count(body, "fixture compact summary") != 1 {
+			t.Fatalf("compacted replay must replace old history and keep one summary; got %s", body)
+		}
+	}
+	continued := send(map[string]any{"type": "response.create", "model": bridgeModel, "input": []any{event.Item, map[string]any{"type": "message", "role": "user", "content": "Continue from summary"}}})
+	check()
+	for range 2 {
+		continued = send(map[string]any{"type": "response.create", "model": bridgeModel, "previous_response_id": completedResponseID(continued), "input": []any{map[string]any{"type": "message", "role": "user", "content": "Next step"}}})
+		check()
+	}
+}
