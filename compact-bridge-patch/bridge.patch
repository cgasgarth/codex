diff --git i/plugin/replay_stream.go w/plugin/replay_stream.go
new file mode 100644
index 0000000..4525b71
--- /dev/null
+++ w/plugin/replay_stream.go
@@ -0,0 +1,57 @@
+package main
+
+import (
+	"encoding/json"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginabi"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
+)
+
+// Relay compacted continuations without buffering the model's response.
+// The host owns cancellation and closes both streams when the client disconnects.
+func delegateOrdinaryStream(req rpcExecutorRequest) ([]byte, error) {
+	raw, err := callHost(pluginabi.MethodHostModelExecuteStream, hostModelExecutionRequest{
+		EntryProtocol: "openai-response", ExitProtocol: "openai-response", Model: req.Model,
+		Stream: true, Body: req.OriginalRequest, Headers: headerToMap(req.Headers),
+		Query: valuesToMap(req.Query), Alt: req.Alt, HostCallbackID: req.HostCallbackID,
+	})
+	if err != nil {
+		return nil, err
+	}
+	var upstream pluginapi.HostModelStreamResponse
+	if err := json.Unmarshal(raw, &upstream); err != nil {
+		return nil, err
+	}
+	go func() {
+		failure := ""
+		defer func() {
+			_, _ = callHost(pluginabi.MethodHostModelStreamClose, pluginapi.HostModelStreamCloseRequest{StreamID: upstream.StreamID})
+			_, _ = callHost(pluginabi.MethodHostStreamClose, map[string]any{"stream_id": req.StreamID, "error": failure})
+		}()
+		for {
+			raw, err := callHost(pluginabi.MethodHostModelStreamRead, pluginapi.HostModelStreamReadRequest{StreamID: upstream.StreamID})
+			if err != nil {
+				failure = err.Error()
+				return
+			}
+			var chunk pluginapi.HostModelStreamReadResponse
+			if err := json.Unmarshal(raw, &chunk); err != nil {
+				failure = err.Error()
+				return
+			}
+			if chunk.Error != "" {
+				failure = chunk.Error
+				return
+			}
+			if len(chunk.Payload) > 0 {
+				if _, err := callHost(pluginabi.MethodHostStreamEmit, map[string]any{"stream_id": req.StreamID, "payload": chunk.Payload}); err != nil {
+					failure = err.Error()
+					return
+				}
+			}
+			if chunk.Done {
+				return
+			}
+		}
+	}()
+	return okEnvelope(map[string]any{"Headers": upstream.Headers})
+}
