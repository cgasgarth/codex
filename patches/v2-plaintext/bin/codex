#!/bin/sh
set -eu
patch_dir=$(CDPATH= cd -P -- "$(dirname -- "$0")/.." && pwd)
app_cli=/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex
installed=$("$app_cli" --version)
built=$(cat "$patch_dir/version.txt" 2>/dev/null || true)
if [ -f "$patch_dir/disabled" ]; then
  unset CODEX_V2_PLAINTEXT
  exec "$app_cli" "$@"
fi
if [ "$installed" != "$built" ] || [ ! -x "$patch_dir/bin/codex-patched" ]; then
  /Users/cgas/.bun/bin/bun "$patch_dir/rebuild.ts" --background
  echo "Updating plaintext V2 in the background; using the bundled backend for this launch. See $patch_dir/update.log" >&2
  unset CODEX_V2_PLAINTEXT
  exec "$app_cli" "$@"
fi
export CODEX_V2_PLAINTEXT=1
exec "$patch_dir/bin/codex-patched" \
  -c 'features.multi_agent_v2.enabled=true' \
  -c 'features.multi_agent_v2.tool_namespace="agents"' \
  -c 'features.multi_agent_v2.hide_spawn_agent_metadata=false' \
  -c 'features.multi_agent_v2.expose_spawn_agent_model_overrides=true' \
  -c 'features.multi_agent_v2.non_code_mode_only=false' \
  "$@"
