# Ignore live Codex data except for selected source and configuration files.
*
!.gitignore
!AGENTS.md
!readme.md
!skills/
!skills/amazon-support-browser/
!skills/amazon-support-browser/**
!skills/consult/
!skills/consult/**
!skills/put-chat-to-work/
!skills/put-chat-to-work/README.md
!skills/typescript-lsp/
!skills/typescript-lsp/**

# Idle compaction source; logs and runtime state remain ignored.
!idle-compact/
!idle-compact/*.ts
!idle-compact/README.md
!idle-compact/*.plist
!model-catalog.json

# Targeted V2 plaintext backend patch; binaries and build output remain local.
!patches/
!patches/v2-plaintext/
!patches/v2-plaintext/.gitignore
!patches/v2-plaintext/*.patch
!patches/v2-plaintext/*.ts
!patches/v2-plaintext/*.sh
!patches/v2-plaintext/*.md
!patches/v2-plaintext/*.json
!patches/v2-plaintext/*.plist
!patches/v2-plaintext/version.txt
!patches/v2-plaintext/bin/
!patches/v2-plaintext/bin/codex
